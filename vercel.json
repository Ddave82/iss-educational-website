{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "iss-educational-website.vercel.app"
        }
      ],
      "destination": "https://iss-education.online/:path*",
      "permanent": true
    },
    {
      "source": "/en",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/en/:path*",
      "destination": "/:path*",
      "permanent": true
    },
    {
      "source": "/teachers",
      "destination": "/learn",
      "permanent": true
    },
    {
      "source": "/teachers/",
      "destination": "/learn",
      "permanent": true
    },
    {
      "source": "/de/teachers",
      "destination": "/de/learn",
      "permanent": true
    },
    {
      "source": "/de/teachers/",
      "destination": "/de/learn",
      "permanent": true
    },
    {
      "source": "/da/teachers",
      "destination": "/da/learn",
      "permanent": true
    },
    {
      "source": "/da/teachers/",
      "destination": "/da/learn",
      "permanent": true
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}
